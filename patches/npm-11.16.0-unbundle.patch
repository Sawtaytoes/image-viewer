-                else:
-                    index = index + 1
-
-            # Update the dependencies. If the dependencies list is empty, it's not
-            # needed, so unhook it.
-            if len(dependencies) > 0:
-                target_dict["dependencies"] = dependencies
-            else:
-                del target_dict["dependencies"]
-
-        elif target_type in linkable_types:
