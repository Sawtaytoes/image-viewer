-    syntax_tree = ast.parse(file_contents)
-    assert isinstance(syntax_tree, ast.Module)
-    c1 = syntax_tree.body
-    assert len(c1) == 1
-    c2 = c1[0]
-    assert isinstance(c2, ast.Expr)
-    return CheckNode(c2.value, [])
