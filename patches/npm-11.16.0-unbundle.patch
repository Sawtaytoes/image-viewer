-            "Outputs": ";".join(outputs),
-            "CommandLine": cmd,
-        },
-    )
-    # Add to the properties of primary input for each config.
-    for config_name, c_data in spec["configurations"].items():
-        p.AddFileConfig(
-            _FixPath(primary_input), _ConfigFullName(config_name, c_data), tools=[tool]
-        )
