-const quoteIfNeeded = val => {
-  if (
-    typeof val === 'boolean' ||
-    typeof val === 'number' ||
-    val.startsWith('true') ||
-    val.startsWith('false') ||
-    /[:\s\n\\",[\]]/g.test(val) ||
