-                os.path.join(base_path, folder), contents, flat
-            )
-            if flat:
-                children += folder_children
-            else:
-                folder_children = MSVSNew.MSVSFolder(
-                    os.path.join(base_path, folder),
-                    name="(" + folder + ")",
-                    entries=folder_children,
-                )
-                children.append(folder_children)
