-        with open(source, "rb") as in_file:
-            s = in_file.read()
-        d = CoreFoundation.CFDataCreate(None, s, len(s))
-        _, error = CoreFoundation.CFPropertyListCreateFromXMLData(None, d, 0, None)
-        if error:
