-                return m.groupdict()["version"]
-        except (GypError, OSError):
-            continue
-
-    regex = re.compile(r"Command Line Tools for Xcode\s+(?P<version>\S+)")
-    try:
-        output = GetStdout(["/usr/sbin/softwareupdate", "--history"])
-        if m := re.search(regex, output):
