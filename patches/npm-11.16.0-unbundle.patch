-                    "for %s flag %r env_name %r" % (action, opt, env_name),
-                    file=sys.stderr,
-                )
-        else:
-            print(
-                "Warning: regeneration unimplemented for action %r "
-                "flag %r" % (action, opt),
-                file=sys.stderr,
-            )
