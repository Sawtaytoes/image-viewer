-            ["-exported_symbols_list", LINKER_FILE],  # Needed for NaCl.
-            ["-unexported_symbols_list", LINKER_FILE],
-            ["-reexported_symbols_list", LINKER_FILE],
-            ["-sectcreate", WORD, WORD, LINKER_FILE],  # Needed for remoting.
