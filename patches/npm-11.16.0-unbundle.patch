-                            "Warning: unrecognized setting %s/%s "
-                            "while converting to MSBuild."
-                            % (msvs_tool_name, msvs_setting)
-                        ),
-                        stderr,
-                    )
-        else:
-            print(
-                "Warning: unrecognized tool %s while converting to "
