-            created_dep_target, dep_target = _GetOrCreateTargetByName(
-                name_to_target, dep
-            )
-            if not created_dep_target:
-                roots.discard(dep_target)
-
-            target.deps.add(dep_target)
-            dep_target.back_deps.add(target)
