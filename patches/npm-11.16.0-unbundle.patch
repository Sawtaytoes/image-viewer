-                )
-        # Required for ffmpeg (no idea why they don't use LIBRARY_SEARCH_PATHS,
-        # TODO(thakis): Update ffmpeg.gyp):
-        if ldflag.startswith("-L"):
-            ldflag = "-L" + gyp_to_build_path(ldflag[len("-L") :])
