-                    except ValueError as e:
-                        print(
-                            "Warning: while converting %s/%s to MSBuild, "
-                            "%s" % (msvs_tool_name, msvs_setting, e),
-                            file=stderr,
-                        )
-                else:
-                    _ValidateExclusionSetting(
