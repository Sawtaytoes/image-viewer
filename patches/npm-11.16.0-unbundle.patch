-
-        if isinstance(child, PBXVariantGroup):
-            child_name = child._properties.get("name", None)
-            key = (child_name, child_path)
-            if key in self._variant_children_by_name_and_path:
-                raise ValueError(
-                    "Found multiple PBXVariantGroup children with "
-                    + "name "
-                    + str(child_name)
-                    + " and path "
-                    + str(child_path)
