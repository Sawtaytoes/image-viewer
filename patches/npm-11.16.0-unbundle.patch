-// say "these are for registry access", "these are for
-// version resolution" etc.
-
-const required = ['type', 'description', 'default', 'key']
-
-const allowed = [
-  'default',
-  'defaultDescription',
-  'deprecated',
-  'description',
-  'exclusive',
-  'flatten',
-  'hint',
-  'key',
-  'short',
-  'type',
-  'typeDescription',
-  'usage',
-  'envExport',
-  'alias',
-  'required',
-]
