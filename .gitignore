# Secrets — never commit
.env
.env.*
!.env.example

# Generated
/.vite
/.eslintcache
/build
/dist
/node_modules
/out
*.log

# Visual regression — shots, the browser build they are taken from, and
# reg-suit's working files (the shared `vrt` job writes its own config)
/.vrt-actual
/.vrt-build
/.reg
/.regconfig.json

# Playwright/ad-hoc screenshots — scratch, not deliverables (fleet-wide rule)
__screenshots__/

# Yarn (Berry) — node-modules linker, no zero-install
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Misc
.DS_Store
