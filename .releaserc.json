{
  "branches": ["master"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "out/make/zip/win32/x64/*.zip",
            "label": "Image-Viewer ${nextRelease.version} (Windows ZIP)"
          },
          {
            "path": "out/make/squirrel.windows/x64/*Setup.exe",
            "label": "Image-Viewer ${nextRelease.version} Setup (Windows)"
          },
          {
            "path": "out/make/squirrel.windows/x64/*.nupkg"
          },
          {
            "path": "out/make/squirrel.windows/x64/RELEASES"
          },
          {
            "path": "out/make/deb/x64/*.deb",
            "label": "Image-Viewer ${nextRelease.version} (Linux x64 .deb)"
          },
          {
            "path": "out/make/rpm/x64/*.rpm",
            "label": "Image-Viewer ${nextRelease.version} (Linux x64 .rpm)"
          },
          {
            "path": "out/make/zip/linux/x64/*.zip",
            "label": "Image-Viewer ${nextRelease.version} (Linux x64 ZIP)"
          },
          {
            "path": "out/make/deb/arm64/*.deb",
            "label": "Image-Viewer ${nextRelease.version} (Linux arm64 .deb)"
          },
          {
            "path": "out/make/rpm/arm64/*.rpm",
            "label": "Image-Viewer ${nextRelease.version} (Linux arm64 .rpm)"
          },
          {
            "path": "out/make/zip/linux/arm64/*.zip",
            "label": "Image-Viewer ${nextRelease.version} (Linux arm64 ZIP)"
          },
          {
            "path": "out/make/zip/darwin/arm64/*.zip",
            "label": "Image-Viewer ${nextRelease.version} (macOS Apple silicon ZIP)"
          },
          {
            "path": "out/make/zip/darwin/x64/*.zip",
            "label": "Image-Viewer ${nextRelease.version} (macOS Intel ZIP)"
          }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
