{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "extends": ["@charcuterie/biome-config"],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.vite",
      "!**/out",
      "!**/dist",
      "!**/build",
      "!src/fonts",
      "!**/.webpack",
      "!**/*.woff",
      "!**/*.woff2",
      "!index.html",
      "!index.browser.html"
    ]
  },
  "linter": {
    "rules": {
      "a11y": {
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      },
      "complexity": {
        "useArrowFunction": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      }
    }
  }
}
